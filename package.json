{
  "name": "grand-family-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Grand Family Discord bot with a persistent SQLite database and production supervisor.",
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "npm run build && node --enable-source-maps ./host-launcher.mjs",
    "start": "node --enable-source-maps ./host-launcher.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.22.1",
    "express": "^5.2.1",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  }
}
